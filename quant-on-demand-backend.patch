@@ -62,6 +62,43 @@ class DependencyHeartbeat:
         self.thread.join(timeout=5)
 
 
+def requested_history_id(sessions, settings, manifest: DataManifest, symbol: str, config: QuantConfig, guard) -> str:
+    from service.quant_data_validation import history_accepted
+
+    with sessions() as db:
+        guard(db)
+        universe = db.get(UniverseVersion, manifest.universe_id)
+        member = universe.payload["members"].get(symbol)
+        if not member:
+            raise DataError("UNKNOWN_INSTRUMENT")
+        if not member.get("sector"):
+            raise DataError("SYMBOL_SECTOR_UNAVAILABLE")
+        rows = db.scalars(select(HistoryRevision).where(HistoryRevision.symbol == symbol,
+            HistoryRevision.target_session == manifest.target_session, HistoryRevision.input_mode == "COMPLETED_DAILY")
+            .order_by((HistoryRevision.id == manifest.histories.get(symbol)).desc(),
+                HistoryRevision.payload["metadata"]["observed_at"].as_string().desc(),
+                HistoryRevision.id).execution_options(yield_per=1))
+        for row in rows:
+            if (len(row.payload["bars"]) >= config.MIN_HISTORY and checksum(row.payload) == row.checksum
+                    and (settings.allow_fixture_analysis or history_accepted(row.payload))):
+                return row.id
+        policy = OperationsPolicy.model_validate(active_version(db, "OPERATIONS").payload)
+        if not policy.ingestion_enabled or not settings.scheduled_provider_enabled:
+            raise DataError("SYMBOL_INGESTION_PAUSED", True)
+    from service.ingestion import configured_provider
+
+    provider = configured_provider(sessions, settings)
+    target = manifest.target_session
+    history = provider.history(symbol, target - timedelta(days=policy.history_calendar_days), target,
+        minimum_bars=config.MIN_HISTORY)
+    with sessions() as db, db.begin():
+        guard(db)
+        if (history.symbol != symbol or history.target_session != target or history.input_mode != "COMPLETED_DAILY"
+                or len(history.payload["bars"]) < config.MIN_HISTORY or not history_accepted(history.payload)):
+            raise DataError("QUANT_DATA_NOT_VALIDATED")
+        return save_history(db, history).id
+
